rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // Phase 3: Primitive Definition
    function isValidId(id) { 
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); 
    }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }
    function isSignedIn() { return request.auth != null; }

    // Phase 2: Validation Blueprints
    function isValidUser(data) {
      return data.keys().hasAll(['email', 'createdAt', 'updatedAt']) &&
             data.email is string && data.email.size() <= 256 &&
             data.createdAt == request.time &&
             data.updatedAt == request.time &&
             (data.get('displayName', '') is string) &&
             (data.get('photoURL', '') is string);
    }
    
    function isValidUserUpdate(data) {
      return data.updatedAt == request.time;
    }

    function isValidLogEntry(data) {
      return data.keys().hasAll(['userId', 'type', 'value', 'date', 'createdAt', 'updatedAt']) &&
             data.userId is string && data.userId.size() <= 128 && data.userId == request.auth.uid &&
             data.type is string && data.type.size() <= 100 &&
             data.value is string && data.value.size() <= 100 &&
             data.date is string && data.date.size() <= 20 &&
             (data.get('notes', '') is string) && (data.get('notes', '').size() <= 1000) &&
             data.createdAt == request.time &&
             data.updatedAt == request.time;
    }

    function isValidLogEntryUpdate(data) {
      return data.updatedAt == request.time &&
             data.userId == existing().userId &&
             data.createdAt == existing().createdAt;
    }

    // Users Collection
    match /users/{userId} {
      allow get: if isSignedIn() && isValidId(userId) && request.auth.uid == userId;
      allow list: if false; // No blanket reads of users
      
      allow create: if isSignedIn() && 
                    isValidId(userId) && 
                    request.auth.uid == userId && 
                    isValidUser(incoming()) &&
                    incoming().email == request.auth.token.email;
                    
      allow update: if isSignedIn() && 
                    isValidId(userId) && 
                    request.auth.uid == userId &&
                    isValidUserUpdate(incoming()) &&
                    incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'photoURL', 'updatedAt']);
                    
      allow delete: if false; // Users cannot delete their own record directly, require cloud function
    }

    // Logs Collection
    match /logs/{logId} {
      // Users can only read their own logs
      allow get: if isSignedIn() && isValidId(logId) && existing().userId == request.auth.uid;
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      
      allow create: if isSignedIn() &&
                    isValidId(logId) &&
                    isValidLogEntry(incoming());
                    
      allow update: if isSignedIn() &&
                    isValidId(logId) &&
                    existing().userId == request.auth.uid &&
                    isValidLogEntryUpdate(incoming()) &&
                    incoming().diff(existing()).affectedKeys().hasOnly(['type', 'value', 'date', 'notes', 'updatedAt']);
                    
      allow delete: if isSignedIn() && isValidId(logId) && existing().userId == request.auth.uid;
    }
  }
}
